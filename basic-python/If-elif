'''
Subject marks with if-elif 
'''

num = int(input("enter the mark: "))

if(num>90):
    print("O")
elif(num >= 81 and num < 90):
    print("A")
elif(num >=71 and num <80):
    print("B")
elif(num >=61 and num<70):
    print("C")
elif(num >=50 and num<60):
    print("D")
elif(num <= 50):
    print("F")
else:
    print("Invalid")