''' Nested Loop '''

a = int(input("Enter the Lower limit"))
b = int(input("Enter the upper limit"))
print("The prime number between", a, "and" , b, "are: ")
for i in range(a, b+1):
    if(i > 1):
        for j in range(2, i):
            if(i % j == 0):
                break
        else:
            print(i)